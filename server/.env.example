# Server Configuration
NODE_ENV=development
PORT=3001

# Database (Supabase PostgreSQL)
DATABASE_URL="postgresql://user:password@host:5432/jamat?schema=public"

# Firebase Admin SDK — same service account is used for ID-token verification
# AND for sending FCM push notifications.
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com

# Push notifications (FCM). Defaults to false so dev/staging don't accidentally
# fire real pushes when a keeper submits timings. Production sets this to "true".
# When false, notifyKeeperUpdate() logs the intended payload and returns —
# everything else in the submission flow runs identically.
FCM_ENABLED=false

# CORS Settings
ALLOWED_ORIGINS=http://localhost:8000,http://localhost:3000

# JWT signing for our own bearer tokens (issued by /api/auth/login,
# /register, /google). MUST be at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Rotating this invalidates every existing session — every signed-in
# user has to re-login. Don't share across environments.
JWT_SECRET=
# Optional. Default '30d' (jsonwebtoken format). Lower for stricter
# logout-after-X-days policy; higher for less frequent re-login.
JWT_EXPIRES_IN=30d

# Dev-auth fallback: when set, the server trusts the X-Dev-User-Email
# header as identity (creating the user on first request). Only safe
# in dev/test environments. NEVER set in production — anyone can
# impersonate anyone with this on. Leave unset (or commented) in prod.
# DEV_AUTH_USER_EMAIL=demo@local

# Optional: Sentry Error Monitoring
SENTRY_DSN=

# Bulk Jummah bootstrap importers. Keep false/unset once community-submitted
# times are dense enough; importers refuse --apply unless this is true.
JUMMAH_SCRAPER_ENABLED=false
JUMMAH_SCRAPER_USER_EMAIL=default-scraped-time@takbeertime.local
JUMMAH_SCRAPER_USER_NAME="default scraped time"
MAWAQIT_TIMEKEEPER_EMAIL=mawaqit-timekeeper@takbeertime.local
MAWAQIT_TIMEKEEPER_NAME=MayAllahRewardMawaqit.net
JAMAAT360_TIMEKEEPER_EMAIL=jamaat360-timekeeper@takbeertime.local
JAMAAT360_TIMEKEEPER_NAME=MayAllahRewardJamaat360.com
MASJID_WEBSITE_TIMEKEEPER_EMAIL=masjid-website-timekeeper@takbeertime.local
MASJID_WEBSITE_TIMEKEEPER_NAME=MayAllahRewardMasjidWebsiteAdmins
FIVEPRAYERS_TIMEKEEPER_EMAIL=fiveprayers-timekeeper@takbeertime.local
FIVEPRAYERS_TIMEKEEPER_NAME=MayAllahRewardFivePrayers.org
MOSQUEHQ_TIMEKEEPER_EMAIL=mosquehq-timekeeper@takbeertime.local
MOSQUEHQ_TIMEKEEPER_NAME=MayAllahRewardMosqueHQ.com
JAKIM_ESOLAT_TIMEKEEPER_EMAIL=jakim-esolat-timekeeper@takbeertime.local
JAKIM_ESOLAT_TIMEKEEPER_NAME=MayAllahRewardJAKIMeSolat
MUIS_TIMEKEEPER_EMAIL=muis-timekeeper@takbeertime.local
MUIS_TIMEKEEPER_NAME=MayAllahRewardMUIS
MUIS_DATA_GOV_RESOURCE_ID=d_a6a206cba471fe04b62dd886ef5eaf22
VAKTIJA_BA_TIMEKEEPER_EMAIL=vaktija-ba-timekeeper@takbeertime.local
VAKTIJA_BA_TIMEKEEPER_NAME=MayAllahRewardVaktija.ba
IACAD_DUBAI_TIMEKEEPER_EMAIL=iacad-dubai-timekeeper@takbeertime.local
IACAD_DUBAI_TIMEKEEPER_NAME=MayAllahRewardDubaiIACAD
MOROCCO_HABOUS_TIMEKEEPER_EMAIL=morocco-habous-timekeeper@takbeertime.local
MOROCCO_HABOUS_TIMEKEEPER_NAME=MayAllahRewardMoroccoHabous
DIYANET_AWQAT_TIMEKEEPER_EMAIL=diyanet-awqat-timekeeper@takbeertime.local
DIYANET_AWQAT_TIMEKEEPER_NAME=MayAllahRewardDiyanet
KEMENAG_BIMAS_TIMEKEEPER_EMAIL=kemenag-bimas-timekeeper@takbeertime.local
KEMENAG_BIMAS_TIMEKEEPER_NAME=MayAllahRewardKemenagBimasIslam
WEBSITE_SCRAPER_TIMEOUT_MS=4000
WEBSITE_SCRAPER_MAX_FETCHES=4

# Optional keyed source for U.S. coverage via the official Masjidi API.
# Request a production key from Masjidi; do not ship the public test key.
MASJIDI_API_KEY=
MASJIDI_API_BASE_URL=https://api.masjidiapp.com/v2
MASJIDI_TIMEKEEPER_EMAIL=masjidi-timekeeper@takbeertime.local
MASJIDI_TIMEKEEPER_NAME=MayAllahRewardMasjidiTeam

# Optional: Email Notifications (SendGrid, Mailgun, etc.)
EMAIL_API_KEY=
EMAIL_FROM=noreply@jamat.app
