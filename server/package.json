{
  "name": "jamat-server",
  "version": "1.0.0",
  "description": "Backend API for Jamat Prayer Timings App",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --exec node_modules/.bin/ts-node src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "ts-node prisma/seed.ts",
    "prisma:studio": "prisma studio",
    "enrich:google-mosques": "ts-node src/scripts/enrichUnnamedMosquesGoogle.ts",
    "enrich:google-mosques:prod": "node dist/scripts/enrichUnnamedMosquesGoogle.js",
    "import:jummah": "ts-node scripts/import-jummah.ts",
    "import:jummah:official": "ts-node scripts/import-jummah.ts --source official --global",
    "import:jummah:official-apply": "ts-node scripts/import-jummah.ts --source official --global --apply",
    "import:jummah:mawaqit-refresh": "ts-node scripts/import-jummah.ts --source mawaqit --global --apply --refresh",
    "import:jummah:jamaat360-refresh": "ts-node scripts/import-jummah.ts --source jamaat360 --global --apply --refresh",
    "import:jummah:fiveprayers-refresh": "ts-node scripts/import-jummah.ts --source fiveprayers --global --apply --refresh",
    "import:jummah:mosquehq-refresh": "ts-node scripts/import-jummah.ts --source mosquehq --global --apply --refresh",
    "import:jummah:websites-refresh": "ts-node scripts/import-jummah.ts --source websites --global --apply --refresh",
    "import:jummah:jakim-refresh": "ts-node scripts/import-jummah.ts --source jakim --global --apply --refresh",
    "import:jummah:muis-refresh": "ts-node scripts/import-jummah.ts --source muis --global --apply --refresh",
    "import:jummah:vaktija-refresh": "ts-node scripts/import-jummah.ts --source vaktija --global --apply --refresh",
    "import:jummah:iacad-refresh": "ts-node scripts/import-jummah.ts --source iacad --global --apply --refresh",
    "import:jummah:habous-refresh": "ts-node scripts/import-jummah.ts --source habous --global --apply --refresh",
    "import:jummah:diyanet-refresh": "ts-node scripts/import-jummah.ts --source diyanet --global --apply --refresh",
    "import:jummah:kemenag-refresh": "ts-node scripts/import-jummah.ts --source kemenag --global --apply --refresh",
    "test:scraper-parsers": "ts-node scripts/test-scraper-parsers.ts",
    "seo:generate": "ts-node scripts/seo/generate-seo-pages.ts",
    "seo:generate:dry": "ts-node scripts/seo/generate-seo-pages.ts --dry",
    "test": "jest --coverage"
  },
  "keywords": [
    "prayer",
    "mosque",
    "timings",
    "api"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^5.8.0",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.4.1",
    "firebase-admin": "^12.0.0",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.10.6",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "prisma": "^5.8.0",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
