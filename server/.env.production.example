# ============================================================
# Jamat Backend - Production Environment Template
# ============================================================
# Copy to `.env.production` on the server and fill in real values.
# DO NOT commit `.env.production` itself.

NODE_ENV=production
PORT=3001

# ---- Database ----
# PostgreSQL with PostGIS 3.4+ required.
# Hosted options: Supabase, Neon (with PostGIS extension enabled), Railway with postgis image.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/jamat?schema=public&sslmode=require"

# ---- Firebase Admin SDK ----
# Generate a service account in Firebase Console → Project Settings → Service Accounts.
# Paste the JSON values verbatim. The private key MUST keep its \n escapes.
# The same service account is used for ID-token verification AND for sending
# FCM push notifications — no separate FCM credentials.
FIREBASE_PROJECT_ID=jamat-prod
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@jamat-prod.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# ---- Push notifications (FCM) ----
# Set to "true" to actually send pushes when keepers submit timing updates.
# When unset/false, the server logs the intended payload and skips the send —
# safe for staging deploys that share the production database.
# Server-side: see docs/PUSH_NOTIFICATIONS.md (already implemented).
# Client-side: handled by the Capacitor mobile app (FCM topic subscription
# happens entirely client-side; no /push-tokens endpoint).
FCM_ENABLED=true

# ---- Auth bypass ----
# CRITICAL: leave this UNSET in production. If set, any request with header
# `X-Dev-User-Email: someone@example.com` is treated as that user — full
# account-takeover via header. Used in dev/staging only.
# DEV_AUTH_USER_EMAIL=

# ---- Admin test-push (POST /api/admin/test-push) ----
# Lets one specific signed-in user fire an FCM keeper-update push to a
# (keeper, masjid) topic without composing a real submission. Used during
# the initial app-team integration to verify subscription + channel +
# payload end-to-end. Both vars must be set; either alone has no effect
# (route returns 404). Unset both when the testing window closes.
# ADMIN_TEST_PUSH_ENABLED=true
# ADMIN_TEST_PUSH_USER_ID=<your-User.id-uuid>


# ---- CORS ----
# Comma-separated list of origins allowed to call the API.
# Include the production web origin AND any staging origins.
ALLOWED_ORIGINS=https://jamat.app,https://www.jamat.app

# ---- Optional: Sentry ----
SENTRY_DSN=

# ---- Optional: Email (password reset, notifications) ----
EMAIL_API_KEY=
EMAIL_FROM=noreply@jamat.app
